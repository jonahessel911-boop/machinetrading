generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Lead {
  id              String      @id @default(cuid())
  merk            String
  model           String?
  timing          String
  naam            String
  email           String
  telefoon        String
  woonplaats      String
  status          String      @default("nieuw")
  contactAttempts Int         @default(0)
  inkoopprijs     Float?
  marge           Float?
  buyerId         String?
  buyer           Buyer?      @relation(fields: [buyerId], references: [id])
  contracts       Contract[]
  photos          LeadPhoto[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model LeadPhoto {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  createdAt    DateTime @default(now())
}

model Buyer {
  id        String     @id @default(cuid())
  naam      String
  email     String?
  telefoon  String?
  bedrijf   String
  leads     Lead[]
  contracts Contract[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Contract {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id])
  buyerId   String
  buyer     Buyer     @relation(fields: [buyerId], references: [id])
  status    String    @default("concept")
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
